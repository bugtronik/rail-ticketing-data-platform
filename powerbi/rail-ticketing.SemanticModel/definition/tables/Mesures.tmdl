table Mesures
	lineageTag: a4c576f4-860c-4b17-8611-531aa87dbcf2

	measure 'Billets vendus' = CALCULATE ( COUNTROWS ( fct_tickets ), fct_tickets[is_paid] = TRUE () )
		formatString: #,0
		displayFolder: 1. Ventes
		lineageTag: d5ec3a15-186e-4f2f-b40c-16bdc291e647

	measure 'Billets annulés' = CALCULATE ( COUNTROWS ( fct_tickets ), fct_tickets[is_cancelled] = TRUE () )
		formatString: #,0
		displayFolder: 1. Ventes
		lineageTag: bf78f205-abe2-4df9-9b62-44ec4617fd5b

	measure 'CA brut' = SUM ( fct_tickets[sales_amount] )
		formatString: #,0
		displayFolder: 1. Ventes
		lineageTag: 8c6ca11d-3238-4d2d-bee2-aa87fafcacea

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Remboursements = SUM ( fct_tickets[refunded_amount] )
		formatString: #,0
