	/// Taux de remplissage du jour, sur les 60 derniers jours complets.
	measure 'Taux de remplissage quotidien' =
			VAR _jour = MAX ( dim_date[date_day] )
			VAR _fin = [Dernier jour complet]
			RETURN IF ( _jour <= _fin && _jour > _fin - 60, [Taux de remplissage] )
		formatString: 0.0%
		displayFolder: 5. Tendances
		lineageTag: 4fa0cf54-9af3-460a-844c-fdf11bf26cac

	partition Mesures = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Colonne 1" = _t]),
				    #"Colonnes supprimées" = Table.RemoveColumns(Source,{"Colonne 1"})
				in
				  #"Colonnes supprimées"

	annotation PBI_ResultType = Table
