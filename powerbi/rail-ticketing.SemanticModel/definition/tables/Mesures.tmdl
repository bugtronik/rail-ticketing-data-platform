		displayFolder: 1. Ventes
		lineageTag: d1c4244a-65a8-4c02-be96-c9dac3cd9ff8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Taux d''annulation' = DIVIDE ( [Billets annulés], [Billets vendus] )
		formatString: 0.0%
		displayFolder: 1. Ventes
		lineageTag: 7b122241-c9b0-4531-b3ea-e2ac3136c91a

	measure 'Taux de remboursement' = DIVIDE ( [Remboursements], [CA brut] )
		formatString: 0.0%
		displayFolder: 1. Ventes
		lineageTag: 9f4df766-e464-4c1b-9e3e-9ce3deea4e06

	measure 'Part du CA en ligne' = DIVIDE ( CALCULATE ( [CA brut], KEEPFILTERS ( dim_channel[is_online] = TRUE () ) ), [CA brut] )
		formatString: 0.0%
		displayFolder: 1. Ventes
		lineageTag: d6b98d29-f998-48c1-afda-520caae5043c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CA par date de voyage' = CALCULATE ( [CA brut], USERELATIONSHIP ( fct_tickets[departure_date], dim_date[date_day] ) )
		formatString: #,0
		displayFolder: 1. Ventes
		lineageTag: 8b60230c-e7ef-4ea0-8c98-88d55b83a2bf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Passagers-km = CALCULATE ( SUM ( fct_trip_occupancy[passenger_km] ), fct_trip_occupancy[trip_status] = "COMPLETED" )
		formatString: #,0
		displayFolder: 2. Exploitation
		lineageTag: e39c7aa0-bb37-41a0-bc18-48cef3fc9f74

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Sièges-km = CALCULATE ( SUM ( fct_trip_occupancy[seat_km] ), fct_trip_occupancy[trip_status] = "COMPLETED" )
		formatString: #,0
