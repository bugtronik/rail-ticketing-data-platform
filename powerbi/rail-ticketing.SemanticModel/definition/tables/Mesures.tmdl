		lineageTag: eda0e385-09be-4255-91e9-d55c88e3efdf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Taux de remplissage' = DIVIDE ( [Passagers-km], [Sièges-km] )
		formatString: 0.0%
		displayFolder: 2. Exploitation
		lineageTag: dda6063e-a476-4c12-97e5-bf8ee52260e4

	/// Ventes payées sur le site web et l'application mobile.
	measure 'CA brut en ligne' = CALCULATE ( [CA brut], KEEPFILTERS ( dim_channel[is_online] = TRUE () ) )
		formatString: #,0
		displayFolder: 1. Ventes
		lineageTag: b7b2968a-e384-58b1-8130-c55a18550f19

	measure 'Billets par commande' =
			VAR _commandes = CALCULATE ( DISTINCTCOUNT ( fct_tickets[order_id] ), fct_tickets[is_paid] = TRUE () )
			RETURN DIVIDE ( [Billets vendus], _commandes )
		formatString: 0.00
		displayFolder: 1. Ventes
		lineageTag: 237d12ed-db0f-53e5-86ad-48429dfecd84

	/// Nombre moyen de jours entre l'achat et le départ du train.
	measure 'Anticipation moyenne (jours)' =
			CALCULATE (
			    AVERAGEX ( fct_tickets, DATEDIFF ( fct_tickets[order_date], fct_tickets[departure_date], DAY ) ),
			    fct_tickets[is_paid] = TRUE ()
			)
		formatString: 0.0
		displayFolder: 1. Ventes
		lineageTag: f6e4ace3-0177-552c-a1b7-b9d016e5a2ea

	measure 'Trajets réalisés' = CALCULATE ( COUNTROWS ( fct_trip_occupancy ), fct_trip_occupancy[trip_status] = "COMPLETED" )
		formatString: #,0
		displayFolder: 2. Exploitation
		lineageTag: 6a6ac170-76dd-5771-9ea2-3339749d6b81

	measure 'Trajets annulés' = CALCULATE ( COUNTROWS ( fct_trip_occupancy ), fct_trip_occupancy[trip_status] = "CANCELLED" )
		formatString: #,0
		displayFolder: 2. Exploitation
		lineageTag: 33b51031-efbb-5b4f-9603-5475eef0f075

	measure 'Taux d''annulation des trajets' = DIVIDE ( [Trajets annulés], [Trajets réalisés] + [Trajets annulés] )
		formatString: 0.0%
		displayFolder: 2. Exploitation
		lineageTag: f37d5dd5-47aa-5d2a-aef7-331c3a54bd98

	measure 'Voyageurs moyens par train' =
			VAR _voyageurs = CALCULATE ( SUM ( fct_trip_occupancy[tickets_sold] ), fct_trip_occupancy[trip_status] = "COMPLETED" )
			RETURN DIVIDE ( _voyageurs, [Trajets réalisés] )
		formatString: #,0
		displayFolder: 2. Exploitation
		lineageTag: 9d31c52f-1708-55ea-bce7-89a988f67f00

	/// La veille du dernier jour de vente : le jour en cours est incomplet.
	measure 'Dernier jour complet' = CALCULATE ( MAX ( fct_tickets[order_date] ), REMOVEFILTERS () ) - 1
		formatString: dd/mm/yyyy
		displayFolder: 4. Contexte
		lineageTag: 646813fb-68a8-55b9-8b88-539052ec2219

	measure 'Libellé période 30 j' =
			VAR _fin = [Dernier jour complet]
			RETURN
			    "30 derniers jours complets : du " & FORMAT ( _fin - 29, "dd/mm/yyyy" ) & " au "
			        & FORMAT ( _fin, "dd/mm/yyyy" ) & ", comparés aux 30 jours précédents"
		displayFolder: 4. Contexte
		lineageTag: 8fc24cc6-6be2-5331-9a6c-8985aacfb0a6

	measure 'Libellé fraîcheur' =
			VAR _charge = CALCULATE ( MAX ( fct_tickets[_loaded_at] ), REMOVEFILTERS () )
			RETURN "Données chargées le " & FORMAT ( _charge, "dd/mm/yyyy à hh:nn" ) & " (UTC)"
		displayFolder: 4. Contexte
		lineageTag: f2c5adb9-011d-5d5e-8ab8-47f438f40386

	/// CA net du jour, sur les 60 derniers jours complets.
	measure 'CA net quotidien' =
			VAR _jour = MAX ( dim_date[date_day] )
			VAR _fin = [Dernier jour complet]
			RETURN IF ( _jour <= _fin && _jour > _fin - 60, [CA net] )
		formatString: #,0
		displayFolder: 5. Tendances
		lineageTag: 7086e821-cd2f-5a2e-90c3-03b81edfb72e

	measure 'CA net moyenne mobile 7 j' =
			VAR _jour = MAX ( dim_date[date_day] )
			VAR _fin = [Dernier jour complet]
			RETURN
			    IF (
			        _jour <= _fin && _jour > _fin - 60,
			        AVERAGEX ( DATESINPERIOD ( dim_date[date_day], _jour, -7, DAY ), [CA net] )
			    )
		formatString: #,0
		displayFolder: 5. Tendances
		lineageTag: e3145988-7db8-57c4-a4c5-bac42618e7f1

	measure 'Taux de remplissage moyenne mobile 7 j' =
			VAR _jour = MAX ( dim_date[date_day] )
			VAR _fin = [Dernier jour complet]
			RETURN
			    IF (
			        _jour <= _fin && _jour > _fin - 60,
			        CALCULATE ( [Taux de remplissage], DATESINPERIOD ( dim_date[date_day], _jour, -7, DAY ) )
			    )
		formatString: 0.0%
		displayFolder: 5. Tendances
		lineageTag: 57241233-703f-52bd-ba06-348fc2b2547e

	measure 'Part du CA en ligne moyenne mobile 7 j' =
			VAR _jour = MAX ( dim_date[date_day] )
			VAR _fin = [Dernier jour complet]
			RETURN
			    IF (
			        _jour <= _fin && _jour > _fin - 60,
			        CALCULATE ( [Part du CA en ligne], DATESINPERIOD ( dim_date[date_day], _jour, -7, DAY ) )
			    )
		formatString: 0.0%
		displayFolder: 5. Tendances
		lineageTag: b3c6ef15-88f3-5f33-a74c-f7864b4f2751

	measure 'CA net 30 j' =
			VAR _fin = [Dernier jour complet]
			RETURN CALCULATE ( [CA net], DATESBETWEEN ( dim_date[date_day], _fin - 29, _fin ) )
		formatString: #,0
		displayFolder: 2. Indicateurs 30 j
		lineageTag: 260452cb-5e72-5a54-ab34-f002dfa82402

	measure 'CA net 30 j préc.' =
			VAR _fin = [Dernier jour complet] - 30
			RETURN CALCULATE ( [CA net], DATESBETWEEN ( dim_date[date_day], _fin - 29, _fin ) )
		formatString: #,0
		displayFolder: 3. Évolutions 30 j
		lineageTag: 841010ae-ca07-5450-b28f-8c43816a718b

	measure 'Évol. CA net 30 j' = DIVIDE ( [CA net 30 j] - [CA net 30 j préc.], [CA net 30 j préc.] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3. Évolutions 30 j
		lineageTag: 9b7fa548-6e31-5330-8c1c-e25f3cfde058

	measure 'Évol. CA net 30 j (texte)' =
			VAR _evol = [Évol. CA net 30 j]
			RETURN
			    IF (
			        ISBLANK ( _evol ),
			        "Pas de période de comparaison",
			        IF ( _evol >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _evol ), "0.0 %" ) & " vs 30 j préc."
			    )
		isHidden
		displayFolder: 9. Mise en forme
		lineageTag: 56ecb2ed-75af-5dca-9ff4-66e8c38646c5

	measure 'Évol. CA net 30 j (couleur)' =
			VAR _evol = [Évol. CA net 30 j]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _evol ), "#8589B3", _evol >= 0, "#1E7B45", "#C62828" )
		isHidden
		displayFolder: 9. Mise en forme
		lineageTag: ddaf454a-3bd8-50b8-861b-409ade60458d

