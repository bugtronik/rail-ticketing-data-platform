	/// Libellé français de passenger_type, pour l'affichage.
	column 'Type de voyageur' = SWITCH ( fct_tickets[passenger_type], "ADULT", "Adulte", "CHILD", "Enfant", "YOUTH", "Jeune", "SENIOR", "Senior", fct_tickets[passenger_type] )
		dataType: string
		lineageTag: 2580a290-78f9-4bce-8d22-d4f583afb2d0
		summarizeBy: none

	/// Libellé français de fare_type, pour l'affichage.
	column 'Type de tarif' = SWITCH ( fct_tickets[fare_type], "FLEX", "Flexible", "STANDARD", "Standard", "SAVER", "Économique", fct_tickets[fare_type] )
		dataType: string
		lineageTag: fc5ab19a-76d5-49e8-89b6-84f2336531d2
		summarizeBy: none

