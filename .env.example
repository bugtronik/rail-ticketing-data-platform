# Copy this file to .env (git-ignored) and change the values:
#     cp .env.example .env
# These defaults are for a local, throwaway environment only.

# --- MariaDB source (simulated production OLTP) -----------------------------
MARIADB_HOST=127.0.0.1
MARIADB_BIND_ADDRESS=127.0.0.1
# Change the port if 3306 is already used on your machine.
MARIADB_PORT=3306
MARIADB_DATABASE=ticketing
MARIADB_ROOT_PASSWORD=change_me_root
# Application account (data generator): SELECT, INSERT, UPDATE.
APP_DB_PASSWORD=change_me_app
# Extraction account: read-only, 2 connections max.
ETL_DB_PASSWORD=change_me_etl

# --- PostgreSQL warehouse -----------------------------------------------------
WAREHOUSE_HOST=127.0.0.1
# Change the port if 5432 is already used on your machine.
WAREHOUSE_PORT=5432
# Same rule as MARIADB_BIND_ADDRESS above.
WAREHOUSE_BIND_ADDRESS=127.0.0.1
WAREHOUSE_DB=warehouse
# Administrator: creates roles and schemas (and the throwaway test databases).
WAREHOUSE_ADMIN_USER=warehouse_admin
WAREHOUSE_ADMIN_PASSWORD=change_me_admin
# Extraction account: writes the raw and meta schemas only.
EXTRACTOR_DB_PASSWORD=change_me_extractor
# dbt account: reads raw, builds the staging, intermediate and marts schemas.
TRANSFORMER_DB_PASSWORD=change_me_transformer

# --- Simulated activity (docker compose) --------------------------------------
# Days of history generated by the `seed` service when the source is EMPTY.
# 90 takes about a minute; 730 (2 years) several minutes.
SEED_DAYS=90

# --- Airflow ------------------------------------------------------------------
# Web UI: http://localhost:8080 (change the port if 8080 is taken).
AIRFLOW_PORT=8080
AIRFLOW_BIND_ADDRESS=127.0.0.1
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow
# Airflow's own metadata database (a separate PostgreSQL container).
# Letters, digits, - and _ only: it is written inside a connection URL.
AIRFLOW_DB_PASSWORD=change_me_airflow_db
# Shared by all Airflow components. Any long random string, e.g.:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=change_me_jwt_secret
AIRFLOW_API_SECRET_KEY=change_me_api_secret
# Encrypts the connections and variables stored by Airflow. Must be 32
# random bytes, url-safe base64 (this example is valid, generate your own):
#     python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=aaRJFAz5yAVVTNDcbcbPfxX9Fsxk5Hq7qj6nvo4ZT9Y=
