# SQLFluff: SQL linter.
# Default dialect is PostgreSQL (warehouse + dbt).
# The MariaDB source schema will override it with a .sqlfluff file in its own
# folder (SQLFluff merges configs from the root down to each file's folder).
[sqlfluff]
dialect = postgres
max_line_length = 100
# Rules we deliberately skip:
#   AM04: "SELECT *" is used in dbt staging CTEs (the "import" pattern).
exclude_rules = AM04

[sqlfluff:indentation]
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper
