# --- Secrets & local config -------------------------------------------------
# Real credentials live only in .env, which is never committed.
# .env.example (committed) documents the expected variables.
.env
.env.*
!.env.example

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# --- dbt --------------------------------------------------------------------
target/
dbt_packages/
logs/
# Anonymous id for dbt's usage stats (turned off in dbt_project.yml anyway).
.user.yml

# --- Power BI project (PBIP) ---------------------------------------------------
# Local cache of the imported data and per-user settings: rebuilt by Desktop.
**/.pbi/localSettings.json
**/.pbi/cache.abf

# --- Airflow ----------------------------------------------------------------
airflow/logs/

# --- Editors & OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

*.swp
*.swo
